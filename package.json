{
  "name": "zapier-lenz",
  "version": "1.3.3",
  "description": "Fact-check claims and catch AI hallucinations with Lenz - verified, sourced verdicts inside your Zaps.",
  "license": "MIT",
  "homepage": "https://lenz.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenzhq/zapier-lenz.git"
  },
  "scripts": {
    "test": "jest --testTimeout 10000"
  },
  "dependencies": {
    "lenz-io": "^2.9.0",
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "jest": "^29.6.0"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "creates/**/*.js",
      "triggers/**/*.js",
      "lib/**/*.js",
      "authentication.js",
      "client.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 85,
        "functions": 88,
        "lines": 95
      }
    }
  },
  "private": true,
  "main": "index.js"
}
