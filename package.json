{
  "name": "zapier-lenz",
  "version": "2.0.0",
  "description": "Fact-check claims and catch AI hallucinations with Lenz - verified, sourced verdicts inside your Zaps.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "homepage": "https://lenz.io",
  "repository": {
    "type": "git",
    "url": "https://github.com/lenzhq/zapier-lenz.git"
  },
  "scripts": {
    "test": "jest --testTimeout 10000 && zapier-platform validate --without-style"
  },
  "dependencies": {
    "lenz-io": "^2.18.0",
    "zapier-platform-core": "19.1.0"
  },
  "devDependencies": {
    "jest": "^29.6.0",
    "zapier-platform-cli": "^19.1.0"
  },
  "overrides": {
    "form-data": "4.0.6",
    "tar": "7.5.22",
    "adm-zip": "0.6.1",
    "tmp": "0.2.7",
    "sigstore": "4.1.1",
    "@sigstore/core": "3.2.1",
    "yeoman-environment": "6.0.1"
  },
  "jest": {
    "collectCoverage": true,
    "collectCoverageFrom": [
      "creates/**/*.js",
      "triggers/**/*.js",
      "lib/**/*.js",
      "authentication.js",
      "client.js"
    ],
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 95,
        "branches": 85,
        "functions": 88,
        "lines": 95
      }
    }
  },
  "private": true,
  "main": "index.js"
}
